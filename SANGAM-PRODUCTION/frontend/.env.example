# SANGAM Frontend — environment variables (Day 27)
#
# Copy to .env.local for local development (gitignored).
# Only used by vite.config.js's dev-server proxy; the built app itself
# calls relative /api/* paths and has no other runtime config.

# Backend URL the Vite dev-server proxy forwards /api/* requests to.
VITE_API_PROXY_TARGET=http://localhost:3000
