                  "delegateUserId",
                  "permission",
                  "unitId",
                  "durationHours",
                  "reason"
                ],
                "properties": {
                  "delegateUserId": {
                    "type": "integer"
                  },
                  "permission": {
                    "$ref": "#/components/schemas/Permission"
                  },
                  "unitId": {
