# SANGAM — Environment Configuration Example
# Copy this file to .env and replace CHANGE_ME values with real secrets.
# Never commit .env to version control.

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://sangam_user:CHANGE_ME@localhost:5432/sangam_db

# ── Application ───────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Auth ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_char_random_hex_string
JWT_REFRESH_SECRET=CHANGE_ME_64_char_random_hex_string_2
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Password Hashing ──────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PASSWORD_PEPPER=CHANGE_ME_32_char_random_hex_string

# ── Audit Log Encryption (AES-256-GCM) ────────────────────────
# Must be exactly 64 hex chars (32 bytes)
AUDIT_ENCRYPTION_KEY=CHANGE_ME_64_hex_chars_for_AES256

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Demo Data (Day 59) ─────────────────────────────────────────
# Set to "true" to seed demo units/users/items/transfers directly into
# this process's live services on startup — the only way to get demo
# data into a server you can actually open in a browser (the standalone
# `npm run seed:demo` script builds disposable services that vanish when
# it exits; it never touches a running server's data). Leave unset for
# a real deployment. Safe to leave set across restarts — re-seeding is
# detected and skipped, not duplicated. To reset the demo to a clean
# state, restart the process (in-memory data does not survive a restart
# regardless of this flag).
SEED_DEMO_DATA=false
